DATABASE_URL=postgres://barbershop:barbershop_dev_password@localhost:5432/barbershop
NODE_ENV=development

# Autenticación (Loop 06) — generar valores reales antes de cualquier entorno compartido,
# nunca usar los defaults de desarrollo en producción. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-in-production
OTP_PEPPER=dev-only-pepper-change-in-production

# Origen(es) del frontend permitidos por CORS, separados por coma. En producción, la URL
# real del deploy de Vercel (ej: https://mi-app.vercel.app).
FRONTEND_URL=http://localhost:5173

# SSL para Postgres — se activa automáticamente si DATABASE_URL apunta a supabase.co.
# Forzar manualmente con PGSSL=true / PGSSL=false si hace falta.
# PGSSL=true

LOG_LEVEL=info

# Envío de email para el OTP de clientes (Resend — https://resend.com, plan free
# alcanza para MVP). Sin esta key, el código se loguea a consola (mock), no bloquea
# desarrollo local. RESEND_FROM_EMAIL debe ser un dominio verificado en Resend, o
# el default de pruebas onboarding@resend.dev (con límites de entrega más chicos).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev
