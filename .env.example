DATABASE_URL=postgres://barbershop:barbershop_dev_password@localhost:5432/barbershop
NODE_ENV=development

# Autenticación (Loop 06) — generar valores reales antes de cualquier entorno compartido,
# nunca usar los defaults de desarrollo en producción. Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-in-production
OTP_PEPPER=dev-only-pepper-change-in-production

# Origen(es) del frontend permitidos por CORS, separados por coma. En producción, la URL
# real del deploy de Vercel (ej: https://mi-app.vercel.app).
FRONTEND_URL=http://localhost:5173

# SSL para Postgres — se activa automáticamente si DATABASE_URL apunta a supabase.co.
# Forzar manualmente con PGSSL=true / PGSSL=false si hace falta.
# PGSSL=true

LOG_LEVEL=info

# Envío de email para el OTP de clientes (Resend — https://resend.com, plan free
# alcanza para MVP). Sin esta key, el código se loguea a consola (mock), no bloquea
# desarrollo local. RESEND_FROM_EMAIL debe ser un dominio verificado en Resend, o
# el default de pruebas onboarding@resend.dev (con límites de entrega más chicos).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=onboarding@resend.dev

# Supabase Storage — logo/portada de la barbería y foto de barberos (bucket
# público "tenant-media"). SUPABASE_SERVICE_ROLE_KEY es un secreto (Settings →
# API Keys → service_role en el dashboard de Supabase) — nunca lo mandes al
# frontend. Sin estas dos, la subida de imágenes devuelve error, el resto de la
# app sigue funcionando.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# Administrador de la plataforma — teléfono(s) (separados por coma) de las cuentas que pueden
# cambiar las fotos de fondo del inicio y la búsqueda desde Configuración → "Fondos de Agenta".
# Debe ser el mismo teléfono con el que esa persona inicia sesión en el panel. Vacío = nadie
# puede (la app usa las imágenes por defecto de frontend/public/img).
# PLATFORM_ADMIN_PHONES=+573001112233
